# Salin ke infra/.env lalu isi. Jangan commit .env. Rahasia produksi disarankan dienkripsi SOPS (TAD §11).
BV_ENV=production
BV_DOMAIN=app.example.com
BV_WEBSITE_DOMAIN=www.example.com          # website publik (Website PRD v1.1); Caddy melayani situs statis + proxy /api
BV_TENANT_DOMAIN=tenant.example.com        # Tenant PWA (dist di $BV_PWA_DIR/tenant, lihat scripts/deploy-pwa.sh)
BV_ROOMS_DOMAIN=rooms.example.com          # BVRooms customer app (dist di $BV_PWA_DIR/rooms)
BV_PWA_DIR=/opt/bv-apps
# Postgres (VPS 4 GB: 512MB/1536MB; 8 GB: 1GB/3GB)
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE=1536MB
# pgBackRest: repo di direktori host (bind mount ke postgres); scripts/pg-backup.sh mirror → MinIO bv-backup (atau S3/R2 lokasi lain)
BV_BACKUP_DIR=/opt/bv-backup
BV_ACME_EMAIL=ops@example.com
BV_PUBLIC_URL=https://app.example.com
BV_CORS_ORIGINS=https://app.example.com,http://localhost,capacitor://localhost   # + https://tenant.<domain>,https://rooms.<domain> bila API dipanggil lintas origin
BV_COOKIE_DOMAIN=
BV_VERSION=latest

# Postgres
POSTGRES_PASSWORD=ganti-password-superuser
BV_APP_DB_PASSWORD=ganti-password-bv_app        # set via infra/scripts/set-db-passwords.sh setelah migrate pertama
BV_WORKER_DB_PASSWORD=ganti-password-bv_worker

# JWT (bvctl keygen) — PEM multi-baris: tulis dengan \n atau pakai docker secrets
BV_JWT_PRIVATE_KEY=
BV_JWT_PUBLIC_KEY=

# Object storage (MinIO lokal atau S3/R2)
BV_S3_ENDPOINT=http://minio:9000
BV_S3_REGION=ap-southeast-3
BV_S3_BUCKET=buildingvision
BV_S3_ACCESS_KEY=minioadmin
BV_S3_SECRET_KEY=minioadmin
BV_S3_PATH_STYLE=true
BV_S3_PUBLIC_ENDPOINT=https://app.example.com   # presigned URL foto/bukti untuk browser & app (Caddy /buildingvision/* → MinIO)

# Push (FCM HTTP v1) — kosong = push nonaktif
BV_FCM_PROJECT_ID=
BV_FCM_SERVICE_ACCOUNT=

# Web Push (VAPID) BVRooms + Tenant App PWA (PRD P3 v2.1 P3-PSH-01) — kosong = push web nonaktif (inbox tetap);
# buat dengan `bvctl vapid-keygen`
BV_VAPID_PUBLIC_KEY=
BV_VAPID_PRIVATE_KEY=
BV_VAPID_SUBJECT=mailto:ops@example.com

# URL Tenant App (PWA) untuk tautan di pesan WhatsApp manual (PRD P3 v2.1 P3-WAM-02); kosong = tanpa tautan
BV_TENANT_APP_URL=https://tenant.example.com

# Demo Seed Database — tooling demo (Settings → Demo Data, `bvctl demo`) aktif di local/staging; production butuh true
BV_DEMO_ENABLED=false
# BVRooms OTP tanpa vendor SMS (hold D3): kode tetap untuk semua nomor (demo/pilot); kosongkan saat vendor SMS terpasang
BV_OTP_STATIC_CODE=
BV_OTP_EXPOSE_CODE=false
# BVRooms: metode login customer. pin (default) = nomor HP + PIN 4 digit tanpa SMS; otp = kembali ke OTP SMS saat vendor terpasang.
# Akun yang belum mengatur PIN memakai BV_BVROOMS_DEFAULT_PIN.
BV_BVROOMS_AUTH=pin
BV_BVROOMS_DEFAULT_PIN=1234

BV_QR_BASE_URL=https://app.example.com/q/
BV_LOG_LEVEL=info
# Zona waktu sesi database (current_date di SQL); default Asia/Jakarta — server Postgres tetap UTC
BV_DB_TIMEZONE=Asia/Jakarta
# Error tracking (PRD P0 v2 §24.4): DSN Sentry/GlitchTip — kosong = nonaktif; BV_RELEASE = versi rilis (tag)
BV_SENTRY_DSN=
BV_RELEASE=dev

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ganti
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0

# Email transaksional (verifikasi signup, notifikasi trial, Book a Demo). Kosong = log-only.
BV_SMTP_HOST=
BV_SMTP_PORT=587
BV_SMTP_USER=
BV_SMTP_PASSWORD=
BV_SMTP_FROM=BuildingVision <no-reply@example.com>
BV_SMTP_STARTTLS=true
BV_SALES_EMAIL=sales@example.com
BV_WEBSITE_URL=https://www.example.com
BV_TRIAL_DAYS=14
