# Caddy — TLS otomatis (Let's Encrypt), HSTS, reverse proxy /api & /public → api (2 replika, round-robin, health check),
# statis / → web build (SPA fallback), /grafana → grafana (basic proteksi lewat login Grafana). TAD §11.2, §11.7.
{
	email {$BV_ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
		metrics
	}
}

{$BV_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(self), microphone=()"
		-Server
	}

	# API + intake publik → Go (dua replika lewat DNS service compose; health check /health)
	@api path /api/* /public/* /health /ready
	handle @api {
		reverse_proxy api:8080 {
			lb_policy round_robin
			health_uri /health
			health_interval 10s
			fail_duration 15s
			header_up X-Request-Id {http.request.uuid}
			transport http {
				read_timeout 65s
			}
		}
	}

	# QR deep link (BV_QR_BASE_URL = https://{domain}/q/) → web SPA yang me-resolve lewat /api/v1/qr/{code}/resolve
	handle /q/* {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Grafana di sub-path
	handle_path /grafana/* {
		reverse_proxy grafana:3000
	}

	# SPA statis
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

# Website publik (Website PRD v1.1): situs statis hasil prerender; /api → api (public endpoints: app-downloads, plans, signup, events).
{$BV_WEBSITE_DOMAIN}, www.{$BV_WEBSITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	@api path /api/*
	handle @api {
		reverse_proxy api:8080 {
			lb_policy round_robin
			health_uri /health
			header_up X-Request-Id {http.request.uuid}
		}
	}
	handle {
		root * /srv-website
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /images/* Cache-Control "public, max-age=2592000"
		try_files {path} {path}/index.html /404.html
		file_server
	}
	handle_errors {
		root * /srv-website
		rewrite * /404.html
		file_server
	}
	log {
		output stdout
		format json
	}
}

# PWA Tenant & BVRooms (repo bv-tenant-app, customer-booking-app): dist statis di /srv-pwa/<app> (infra/scripts/deploy-pwa.sh),
# /api → api (same-origin, tanpa CORS), /sw.js no-cache agar update PWA terdeteksi.
(pwa_site) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	@api path /api/* /public/*
	handle @api {
		reverse_proxy api:8080 {
			lb_policy round_robin
			health_uri /health
			header_up X-Request-Id {http.request.uuid}
			transport http {
				read_timeout 65s
			}
		}
	}
	handle {
		root * {args[0]}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /sw.js Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
		format json
	}
}

{$BV_TENANT_DOMAIN} {
	import pwa_site /srv-pwa/tenant
}

{$BV_ROOMS_DOMAIN} {
	import pwa_site /srv-pwa/rooms
}
